{
  "id": "/",
  "name": "PillSync - Prescription Reader & Health Companion",
  "short_name": "PillSync",
  "description": "Handwritten doctor prescription reader, 7 Indic languages translation, meal-synchronized smart reminders, and offline health companion.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFFFFF",
  "theme_color": "#1E88E5",
  "lang": "en",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/?shared=true",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "prescription",
          "accept": ["image/*", ".heic", ".heif", ".pdf"]
        }
      ]
    }
  },
  "categories": ["medical", "health", "productivity"]
}
